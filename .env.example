# Copiar como .env y rellenar. NUNCA subir .env a GitHub.

# --- Rutas ---
HAND_REVIEW_DIR=G:/Mi unidad/Hand_Review
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- PostgreSQL de PokerTracker 4 ---
PT4_DB_HOST=localhost
PT4_DB_PORT=5432
PT4_DB_NAME=PT4_DB
PT4_DB_USER=postgres
PT4_DB_PASSWORD=
PT4_HAND_ENUM_TYPE=

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Capas en GPU. Vacío = automático. 0 = solo CPU (usar si sale "CUDA error ... PTX ... unsupported toolchain")
OLLAMA_NUM_GPU=

# --- Subida a poker-library.com ---
API_UPLOAD_URL=https://dev.poker-library.com/api_upload.php
API_TOKEN=

# --- Valores de la mano en la web ---
# Nick con el que apareces en la web (tabla users_hand_review)
HERO_ALIAS=
# Uno de: Desconocido (Default), Fish, Reg Agresivo, Nit, Whale / Ballena, Loco-Maniatico, Pagón
DEFAULT_TIPO_RIVAL=Desconocido (Default)
